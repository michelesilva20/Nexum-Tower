generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
  DISABLED
}

enum BranchStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum UserBranchAccessScope {
  MEMBER
  MANAGER
  ADMIN
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum CustomerType {
  CONTRACTING_CUSTOMER
  SHIPPER
  CONSIGNEE
  SHIPPER_AND_CONSIGNEE
  BROKER
  PARTNER
  OTHER
}

enum CustomerDocumentType {
  CNPJ
  CPF
  NIF
  EIN
  VAT
  OTHER
}

enum CustomerBranchStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum LocationStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum LocationType {
  CUSTOMER_SITE
  BRANCH_BASE
  PORT
  TERMINAL
  WAREHOUSE
  DISTRIBUTION_CENTER
  DEPOT
  YARD
  CROSS_DOCKING
  BORDER_CROSSING
  FUEL_STATION
  MAINTENANCE_SITE
  SUPPLIER_SITE
  PARKING_AREA
  OTHER
}

enum LocationBranchStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum DriverStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
  SUSPENDED
  DISABLED
}

enum DriverType {
  INTERNAL
  THIRD_PARTY
  OWNER_OPERATOR
  AGGREGATED
  TEMPORARY
  OTHER
}

enum EmploymentType {
  EMPLOYEE
  CONTRACTOR
  FREELANCER
  AGGREGATED
  OUTSOURCED
  OTHER
}

enum DriverAvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
  ON_TRIP
  OFF_DUTY
  ON_VACATION
  ON_LEAVE
}

enum DriverDocumentType {
  CPF
  RG
  CNH
  PASSPORT
  RNE
  OTHER
}

enum LicenseCategory {
  A
  B
  C
  D
  E
  AB
  AC
  AD
  AE
  OTHER
}

enum DriverBranchStatus {
  ACTIVE
  INACTIVE
  DISABLED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum SettingValueType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  SELECT
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  groups         Group[]
  roles          Role[]
  branches       Branch[]
  customers      Customer[]
  locations      Location[]
  drivers        Driver[]
  tenantSettings TenantSetting[]
  tenantFeatures TenantFeature[]
}

model User {
  id           String     @id @default(cuid())
  tenantId     String
  tenant       Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  passwordHash String?
  status       UserStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  memberships GroupMember[]
  userRoles   UserRole[]
  overrides   UserPermissionOverride[]
  sessions    AuthSession[]
  auditLogs   AuditLog[]
  branchAccess UserBranchAccess[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
}

model Group {
  id          String   @id @default(cuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members GroupMember[]
  roles   GroupRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model GroupMember {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  groupId   String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, groupId])
  @@index([tenantId])
  @@index([groupId])
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String?
  tenant      Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  userRoles   UserRole[]
  groupRoles  GroupRole[]

  @@unique([tenantId, slug])
  @@index([tenantId])
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  module      String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles     RolePermission[]
  overrides UserPermissionOverride[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  roleId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([tenantId])
}

model GroupRole {
  id        String   @id @default(cuid())
  tenantId  String
  groupId   String
  roleId    String
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([groupId, roleId])
  @@index([tenantId])
}

model UserPermissionOverride {
  id           String           @id @default(cuid())
  tenantId     String
  userId       String
  permissionId String
  effect       PermissionEffect
  reason       String?
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission   Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([userId, permissionId])
  @@index([tenantId])
}

model AuthSession {
  id               String    @id @default(cuid())
  tenantId         String
  userId           String
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
}

model SettingDefinition {
  id             String           @id @default(cuid())
  key            String           @unique
  module         String
  label          String
  description    String?
  valueType      SettingValueType
  defaultValue   Json?
  options        Json?
  isTenantScoped Boolean          @default(true)
  isSensitive    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  tenantSettings TenantSetting[]

  @@index([module])
}

model TenantSetting {
  id           String            @id @default(cuid())
  tenantId     String
  definitionId String
  value        Json
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  tenant     Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  definition SettingDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@unique([tenantId, definitionId])
  @@index([tenantId])
}

model Feature {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  module      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenantFeatures TenantFeature[]

  @@index([module])
}

model TenantFeature {
  id        String   @id @default(cuid())
  tenantId  String
  featureId String
  enabled   Boolean  @default(false)
  config    Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  feature Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@unique([tenantId, featureId])
  @@index([tenantId])
}

model Branch {
  id             String       @id @default(cuid())
  tenantId       String
  tenant         Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code           String
  name           String
  legalName      String?
  documentType   String?
  documentNumber String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  country        String?      @default("BR")
  zipCode        String?
  status         BranchStatus @default(ACTIVE)
  isHeadquarters Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  disabledAt     DateTime?
  deletedAt      DateTime?

  userAccess       UserBranchAccess[]
  customerBranches CustomerBranch[]
  locationBranches LocationBranch[]
  driverBranches DriverBranch[]

  // code: identidade operacional permanente — único por tenant (inclui soft-deleted)
  @@unique([tenantId, code])
  // documentNumber: único entre filiais ativas quando informado — índice parcial SQL
  @@index([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, isHeadquarters])
  @@index([tenantId, deletedAt])
}

model UserBranchAccess {
  id              String                @id @default(cuid())
  tenantId        String
  userId          String
  branchId        String
  scope           UserBranchAccessScope @default(MEMBER)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdByUserId String?

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, userId, branchId])
  @@index([tenantId])
  @@index([tenantId, userId])
  @@index([tenantId, branchId])
}

model Customer {
  id                    String               @id @default(cuid())
  tenantId              String
  tenant                Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                  String
  legalName             String
  tradeName             String?
  customerType          CustomerType
  documentType          CustomerDocumentType?
  documentNumber        String?
  stateRegistration     String?
  municipalRegistration String?
  mainContactName       String?
  mainContactRole       String?
  email                 String?
  billingEmail          String?
  phone                 String?
  whatsapp              String?
  website               String?
  billingAddressLine1   String?
  billingAddressLine2   String?
  billingDistrict       String?
  billingCity           String?
  billingState          String?
  billingCountry        String?              @default("BR")
  billingZipCode        String?
  status                CustomerStatus       @default(ACTIVE)
  notes                 String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  disabledAt            DateTime?
  deletedAt             DateTime?

  branches CustomerBranch[]
  locations Location[]

  @@unique([tenantId, code])
  @@index([tenantId, documentNumber])
  @@index([tenantId])
  @@index([tenantId, status])
  @@index([tenantId, customerType])
  @@index([tenantId, deletedAt])
  @@index([tenantId, legalName])
  @@index([tenantId, tradeName])
}

model CustomerBranch {
  id         String               @id @default(cuid())
  tenantId   String
  customerId String
  branchId   String
  isPrimary  Boolean              @default(false)
  status     CustomerBranchStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  disabledAt DateTime?
  deletedAt  DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, customerId, branchId])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, branchId])
  @@index([tenantId, deletedAt])
}

model Location {
  id                    String         @id @default(cuid())
  tenantId              String
  tenant                Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                  String
  name                  String
  locationType          LocationType
  customerId            String?
  customer              Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  addressLine1          String
  addressLine2          String?
  district              String?
  city                  String
  state                 String
  country               String         @default("BR")
  zipCode               String?
  latitude              Float?
  longitude             Float?
  timezone              String?
  geofenceRadiusMeters  Int?
  contactName           String?
  contactRole           String?
  email                 String?
  phone                 String?
  whatsapp              String?
  operatingHours        String?
  accessInstructions    String?
  dockInfo              String?
  referencePoint        String?
  status                LocationStatus @default(ACTIVE)
  notes                 String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  disabledAt            DateTime?
  deletedAt             DateTime?

  branches LocationBranch[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, customerId])
  @@index([tenantId, locationType])
  @@index([tenantId, status])
  @@index([tenantId, city])
  @@index([tenantId, state])
  @@index([tenantId, deletedAt])
  @@index([tenantId, name])
}

model LocationBranch {
  id         String               @id @default(cuid())
  tenantId   String
  locationId String
  branchId   String
  isPrimary  Boolean              @default(false)
  status     LocationBranchStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  disabledAt DateTime?
  deletedAt  DateTime?

  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, locationId, branchId])
  @@index([tenantId])
  @@index([tenantId, locationId])
  @@index([tenantId, branchId])
  @@index([tenantId, deletedAt])
}

model Driver {
  id                       String                   @id @default(cuid())
  tenantId                 String
  tenant                   Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code                     String
  fullName                 String
  preferredName            String?
  driverType               DriverType
  employmentType           EmploymentType
  documentType             DriverDocumentType?
  documentNumber           String?
  licenseNumber            String?
  licenseCategory          LicenseCategory?
  licenseState             String?
  licenseCountry           String?                  @default("BR")
  licenseIssuedAt          DateTime?
  licenseExpiresAt         DateTime?
  hasEar                   Boolean                  @default(false)
  moppCertified            Boolean                  @default(false)
  moppExpiresAt            DateTime?
  birthDate                DateTime?
  email                    String?
  phone                    String?
  whatsapp                 String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  addressLine1             String?
  addressLine2             String?
  district                 String?
  city                     String?
  state                    String?
  country                  String?                  @default("BR")
  zipCode                  String?
  admissionDate            DateTime?
  terminationDate          DateTime?
  contractorCompanyName    String?
  availabilityStatus       DriverAvailabilityStatus @default(AVAILABLE)
  status                   DriverStatus             @default(ACTIVE)
  notes                    String?
  createdAt                DateTime                 @default(now())
  updatedAt                DateTime                 @updatedAt
  disabledAt               DateTime?
  deletedAt                DateTime?

  branches DriverBranch[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([tenantId, documentNumber])
  @@index([tenantId, licenseNumber])
  @@index([tenantId, status])
  @@index([tenantId, availabilityStatus])
  @@index([tenantId, driverType])
  @@index([tenantId, employmentType])
  @@index([tenantId, licenseExpiresAt])
  @@index([tenantId, moppExpiresAt])
  @@index([tenantId, deletedAt])
  @@index([tenantId, fullName])
}

model DriverBranch {
  id         String             @id @default(cuid())
  tenantId   String
  driverId   String
  branchId   String
  isPrimary  Boolean            @default(false)
  status     DriverBranchStatus @default(ACTIVE)
  notes      String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  disabledAt DateTime?
  deletedAt  DateTime?

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([tenantId, driverId, branchId])
  @@index([tenantId])
  @@index([tenantId, driverId])
  @@index([tenantId, branchId])
  @@index([tenantId, deletedAt])
}
