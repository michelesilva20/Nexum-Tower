{
  "name": "nexum-tower",
  "private": true,
  "scripts": {
    "dev": "turbo dev --filter=web --filter=api",
    "dev:web": "pnpm --filter web dev",
    "dev:web:clean": "pnpm --filter web dev:clean",
    "dev:api": "pnpm --filter api start:dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "pnpm --filter api exec tsc --noEmit && pnpm --filter web exec tsc --noEmit",
    "format": "prettier --write .",
    "test": "pnpm --filter api test",
    "test:api": "pnpm --filter api test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:generate": "pnpm --filter database prisma generate",
    "db:migrate": "pnpm --filter database prisma migrate dev",
    "db:migrate:deploy": "pnpm --filter database prisma migrate deploy",
    "db:studio": "pnpm --filter database prisma studio",
    "db:seed": "pnpm --filter database prisma db seed",
    "security:rls:test": "psql \"%DATABASE_URL_APP_USER%\" -f packages/database/sql/security/05-test-rls-isolation.sql"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20"
  }
}
