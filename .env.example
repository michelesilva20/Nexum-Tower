# PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/nexum_tower?schema=public"

# Usuários PostgreSQL restritos (RLS hardening — ver packages/database/sql/security/)
DATABASE_URL_APP_USER="postgresql://nexum_app:change_me_app_password@localhost:5432/nexum_tower?schema=public"
DATABASE_URL_MIGRATOR="postgresql://nexum_migrator:change_me_migrator_password@localhost:5432/nexum_tower?schema=public"

# API
API_PORT=3333
API_CORS_ORIGIN=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
NODE_ENV=development

# JWT / session
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
ACCESS_TOKEN_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Auth cookies (dev usa httpOnly + sameSite lax; secure só em produção por padrão)
AUTH_COOKIE_DOMAIN=""
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAMESITE="lax"

# Web (browser uses /api proxy; INTERNAL_API_URL is the Nest target for rewrites)
INTERNAL_API_URL=http://localhost:3333
NEXT_PUBLIC_API_URL=http://localhost:3333
